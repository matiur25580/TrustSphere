# API
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/trustsphere
JWT_ACCESS_SECRET=replace-with-at-least-32-characters-of-random-secret

# Scheduled saved-report delivery worker (run separately from the API)
REDIS_URL=redis://127.0.0.1:6379
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=TrustSphere Reports <reports@example.com>
