{
  "name": "trustsphere",
  "version": "0.1.0",
  "private": true,
  "description": "AI-assisted enterprise third-party risk and compliance management platform",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:server dev:client",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm-run-all build:server build:client",
    "build:server": "npm run build --workspace server",
    "build:client": "npm run build --workspace client",
    "typecheck": "npm-run-all typecheck:server typecheck:client",
    "typecheck:server": "npm run typecheck --workspace server",
    "typecheck:client": "npm run typecheck --workspace client",
    "worker:reports": "npm run worker:reports --workspace server",
    "worker:sla": "npm run worker:sla --workspace server"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },
  "engines": {
    "node": ">=20"
  }
}
