{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test src/modules/identity/identity.security.test.ts src/modules/assessments/assessment.scoring.test.ts src/modules/findings/finding.scoring.test.ts src/modules/findings/finding.integration.test.ts src/modules/incidents/incident-sla.test.ts src/modules/alerts/alert.integration.test.ts src/modules/reports/saved-report.integration.test.ts src/modules/reports/saved-report-schedule.test.ts",
    "worker:reports": "tsx src/workers/saved-report.worker.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "zod": "^3.24.1",
    "multer": "^2.0.2",
    "bullmq": "^5.34.3",
    "ioredis": "^5.4.2",
    "nodemailer": "^6.10.0",
    "pdfkit": "^0.16.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.2",
    "mongodb-memory-server": "^10.1.4",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "@types/multer": "^1.4.12",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.13.9"
  }
}
